new file mode 100644
index 0000000..8e5b170
--- /dev/null
+++ b/src/cache/metrics.py
@@ -0,0 +1,24 @@
+import threading
+from collections import Counter
+
+
+class Metrics:
+    """Thread-safe counters for hits, misses, and evictions."""
+
+    def __init__(self):
+        self._lock = threading.Lock()
+        self._counts = Counter()
+
+    def record(self, name, amount=1):
+        with self._lock:
+            self._counts[name] += amount
+
+    def snapshot(self):
+        with self._lock:
+            return dict(self._counts)
+
+    def hit_rate(self):
+        counts = self.snapshot()
+        total = counts.get("hit", 0) + counts.get("miss", 0)
+        if total == 0:
+            return 0.0
+        return counts.get("hit", 0) / total
